{
  "name": "dsh-sci-sideband",
  "version": "0.8.1",
  "description": "A research-exploration sideband for DeepSeek Harness: give one interest and objective, auto-discover papers from arXiv, OpenAlex, Crossref, Europe PMC, DOAJ, and Semantic Scholar, analyze them in the background, capture traceable evidence, suggest experiments, and compose review articles.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "research",
    "science",
    "literature",
    "evidence",
    "experiment-design",
    "sideband"
  ],
  "license": "MIT",
  "author": "Dzy-HW-XD",
  "homepage": "https://github.com/Dzy-HW-XD/dsh-sci-sideband#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dzy-HW-XD/dsh-sci-sideband.git"
  },
  "bugs": {
    "url": "https://github.com/Dzy-HW-XD/dsh-sci-sideband/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
